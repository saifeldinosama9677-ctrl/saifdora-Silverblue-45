#~ "Support intégré de 7-Zip, RAR, ZIP, des outils PDF et du traitement d'image."

#~ msgid "Rumman (File & Media Converter)"
#~ msgstr "Rumman (Convertisseur de fichiers et médias)"

#~ msgid "High-performance media converter and file optimizer."
#~ msgstr "Convertisseur multimédia et optimiseur de fichiers haute performance."

