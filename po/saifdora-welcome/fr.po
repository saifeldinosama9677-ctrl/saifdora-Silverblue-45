#: files/system/usr/bin/saifdora-welcome:92
msgid "Welcome to Saifdora"
msgstr "Bienvenue dans Saifdora"

#: files/system/usr/bin/saifdora-welcome:114
msgid "NVIDIA graphics card detected! Official drivers are not installed."
msgstr "Carte NVIDIA détectée ! Les pilotes officiels ne sont pas installés."

#: files/system/usr/bin/saifdora-welcome:115
msgid "Install NVIDIA & CUDA Driver"
msgstr "Installer le pilote NVIDIA & CUDA"

#: files/system/usr/bin/saifdora-welcome:141
msgid "Previous"
msgstr "Précédent"

#: files/system/usr/bin/saifdora-welcome:148
msgid "Show on startup"
msgstr "Afficher au démarrage"

#: files/system/usr/bin/saifdora-welcome:154
#: files/system/usr/bin/saifdora-welcome:512
msgid "Next"
msgstr "Suivant"

#: files/system/usr/bin/saifdora-welcome:272
msgid "Ready Out of the Box"
msgstr "Prêt à l'emploi"

#: files/system/usr/bin/saifdora-welcome:273
msgid ""
"Saifdora Silverblue 45 includes comprehensive codecs, hardware acceleration,"
" and essential utilities pre-configured."
msgstr ""
"Saifdora Silverblue 45 inclut tous les codecs, l'accélération matérielle et "
"les outils essentiels."

#: files/system/usr/bin/saifdora-welcome:280
msgid "Multimedia & Hardware Acceleration"
msgstr "Multimédia & Accélération matérielle"

#: files/system/usr/bin/saifdora-welcome:281
msgid ""
"Full codec support (HEVC, AV1, HEIC) and hardware video decoding for Intel "
"and AMD."
msgstr ""
"Support complet des codecs (HEVC, AV1, HEIC) et accélération pour Intel et "
"AMD."

#: files/system/usr/bin/saifdora-welcome:287
msgid "Curated Repositories"
msgstr "Dépôts configurés"

#: files/system/usr/bin/saifdora-welcome:288
msgid "Flathub and RPM Fusion (Free & Non-Free) enabled out of the box."
msgstr "Flathub et RPM Fusion sont activés par défaut."

#: files/system/usr/bin/saifdora-welcome:294
msgid "Localization & System Tools"
msgstr "Localisation et outils système"

#: files/system/usr/bin/saifdora-welcome:295
msgid ""
"Full support for 12 languages with built-in tools for 7-Zip, RAR, and PDF."
msgstr ""
"Prise en charge de 12 langues avec outils intégrés pour 7-Zip, RAR et PDF."

#: files/system/usr/bin/saifdora-welcome:307
msgid "Integrated Productivity Apps"
msgstr "Applications intégrées"

#: files/system/usr/bin/saifdora-welcome:308
msgid ""
"High-performance desktop applications installed natively in your system."
msgstr "Des applications de bureau performantes installées nativement."

#: files/system/usr/bin/saifdora-welcome:315
msgid "Launch Rumman"
msgstr "Lancer Rumman"

#: files/system/usr/bin/saifdora-welcome:317
msgid "Rumman"
msgstr "Rumman"

#: files/system/usr/bin/saifdora-welcome:318
msgid ""
"Fast, lightweight file converter: drag any file and hold Shift to drop it "
"onto matching formats."
msgstr ""
"Convertisseur rapide et léger : glissez un fichier et maintenez Shift pour "
"afficher les formats compatibles."

#: files/system/usr/bin/saifdora-welcome:325
msgid "Launch MDM"
msgstr "Gestionnaire de téléchargement"

#: files/system/usr/bin/saifdora-welcome:327
msgid "Download Manager"
msgstr "Gestionnaire de téléchargements"

#: files/system/usr/bin/saifdora-welcome:328
msgid ""
"Fast download manager automatically integrated with Firefox (Mister Download"
" Manager)."
msgstr ""
"Gestionnaire de téléchargement rapide automatiquement intégré à Firefox "
"(Mister Download Manager)."

#: files/system/usr/bin/saifdora-welcome:335
msgid "Launch ZapFast"
msgstr "Lancer ZapFast"

#: files/system/usr/bin/saifdora-welcome:337
msgid "ZapFast"
msgstr "ZapFast"

#: files/system/usr/bin/saifdora-welcome:338
msgid "Fast native desktop WhatsApp client built with Rust."
msgstr "Client de bureau WhatsApp rapide et natif développé en Rust."

#: files/system/usr/bin/saifdora-welcome:351
msgid "Interface Customization & Extensions"
msgstr "Personnalisation & Extensions"

#: files/system/usr/bin/saifdora-welcome:352
msgid ""
"Enhance and personalize your GNOME desktop with pre-configured extensions "
"and utilities."
msgstr "Personnalisez votre bureau GNOME avec des extensions préconfigurées."

#: files/system/usr/bin/saifdora-welcome:360
msgid "Lockscreen Clock"
msgstr "Horloge d'écran de verrouillage"

#: files/system/usr/bin/saifdora-welcome:361
msgid ""
"Lockscreen clock with weather and smart regional dates (adapting month names"
" and local calendars by country), fully customizable."
msgstr ""
"Horloge d'écran de verrouillage avec météo et dates régionales "
"intelligentes, entièrement personnalisable."

#: files/system/usr/bin/saifdora-welcome:367
msgid "Manage Extensions"
msgstr "Gérer les extensions"

#: files/system/usr/bin/saifdora-welcome:369
msgid "Desktop Extensions"
msgstr "Extensions de bureau"

#: files/system/usr/bin/saifdora-welcome:370
msgid "Includes ArcMenu app launcher, Dash to Dock, and Clipboard Indicator."
msgstr ""
"Comprend le lanceur d'applications ArcMenu, Dash to Dock et Clipboard "
"Indicator."

#: files/system/usr/bin/saifdora-welcome:377
msgid "Customize Desktop"
msgstr "Personnaliser le bureau"

#: files/system/usr/bin/saifdora-welcome:379
msgid "Interface Tweaks"
msgstr "Ajustements de l'interface"

#: files/system/usr/bin/saifdora-welcome:380
msgid "Fine-tune window buttons and GNOME appearance using Refine."
msgstr ""
"Ajustez les boutons de fenêtre et l'apparence de GNOME à l'aide de Refine."

#: files/system/usr/bin/saifdora-welcome:393
msgid "Hardware & System Updates"
msgstr "Matériel et mises à jour du système"

#: files/system/usr/bin/saifdora-welcome:394
msgid ""
"Optimized for smooth performance across Intel, AMD, and NVIDIA hardware."
msgstr "Performances fluides et optimisées pour Intel, AMD et NVIDIA."

#: files/system/usr/bin/saifdora-welcome:401
msgid "Intel & AMD Acceleration"
msgstr "Accélération Intel & AMD"

#: files/system/usr/bin/saifdora-welcome:402
msgid ""
"Hardware video acceleration (VA-API / Mesa / Intel Media Driver) is pre-"
"configured and active."
msgstr "Accélération vidéo matérielle préconfigurée et active."

#: files/system/usr/bin/saifdora-welcome:407
msgid "Open NVIDIA Manager"
msgstr "Gestionnaire NVIDIA"

#: files/system/usr/bin/saifdora-welcome:409
msgid "NVIDIA & CUDA Drivers"
msgstr "Pilotes NVIDIA & CUDA"

#: files/system/usr/bin/saifdora-welcome:410
msgid ""
"Detect your GPU model, install official drivers, configure CUDA, and manage "
"Secure Boot."
msgstr ""
"Détectez votre carte, installez les pilotes officiels et configurez CUDA."

#: files/system/usr/bin/saifdora-welcome:417
msgid "Safe Atomic Updates"
msgstr "Mises à jour atomiques sécurisées"

#: files/system/usr/bin/saifdora-welcome:418
msgid ""
"Immutable Fedora Silverblue base protects the system and enables instant "
"rollbacks."
msgstr ""
"La base immuable de Fedora Silverblue protège le système et permet des "
"retours arrière instantanés."

#: files/system/usr/bin/saifdora-welcome:430
msgid "GNOME 51 Navigation Basics"
msgstr "Bases de navigation dans GNOME 51"

#: files/system/usr/bin/saifdora-welcome:431
msgid ""
"Master simple gestures and shortcuts to move swiftly through your workspace."
msgstr "Gestes et raccourcis simples pour naviguer efficacement."

#: files/system/usr/bin/saifdora-welcome:438
msgid "Super Key & Search"
msgstr "Touche Super & Recherche"

#: files/system/usr/bin/saifdora-welcome:439
msgid ""
"Press the Super (Windows) key to open the Activities Overview, search apps, "
"files, or do quick math."
msgstr ""
"Appuyez sur la touche Super pour ouvrir les Activités et effectuer des "
"recherches."

#: files/system/usr/bin/saifdora-welcome:445
msgid "Touchpad Gestures"
msgstr "Gestes sur le pavé tactile"

#: files/system/usr/bin/saifdora-welcome:446
msgid ""
"Swipe up/down with 3 fingers for Overview; swipe left/right with 3 fingers "
"to switch workspaces."
msgstr ""
"Glissez à 3 doigts vers le haut/bas pour les Activités, gauche/droite pour "
"les espaces."

#: files/system/usr/bin/saifdora-welcome:452
msgid "Dynamic Workspaces"
msgstr "Espaces de travail dynamiques"

#: files/system/usr/bin/saifdora-welcome:453
msgid ""
"Workspaces are created automatically as you open windows to keep your "
"desktop organized."
msgstr "Les espaces se créent automatiquement pour organiser vos fenêtres."

#: files/system/usr/bin/saifdora-welcome:479
msgid ""
"Application installation is completing in the background, it will appear in "
"the menu within minutes"
msgstr ""
"L'installation de l'application se termine en arrière-plan, elle apparaîtra "
"dans le menu d'ici quelques minutes"

#: files/system/usr/bin/saifdora-welcome:510
msgid "Get Started"
msgstr "Démarrer"

