        """Slide 2: Integrated productivity apps (3 rows)."""
        slide, box = self.create_slide_container(
            "system-software-install-symbolic",
            _("Integrated Productivity Apps"),
            _("High-performance desktop applications installed natively in your system.")
        )
        listbox = Gtk.ListBox()
        listbox.add_css_class("boxed-list")
        listbox.set_selection_mode(Gtk.SelectionMode.NONE)

        # Rumman
        btn1 = self.create_row_button(_("Launch Rumman"), lambda *a: self.launch_local_app(["/usr/bin/rumman"]))
        r1 = self.create_action_row(
            _("Rumman"),
            _("Fast, lightweight file converter: drag any file and hold Shift to drop it onto matching formats."),
            "system-run-symbolic",
            btn1
        )
        listbox.append(r1)

        # Mister Download Manager
        btn2 = self.create_row_button(_("Launch MDM"), lambda *a: self.launch_local_app(["/usr/bin/misterdownloadmanager"]))
        r2 = self.create_action_row(
            _("Download Manager"),
            _("Fast download manager automatically integrated with Firefox (Mister Download Manager)."),
            "folder-download-symbolic",
            btn2
        )
        listbox.append(r2)

        # ZapFast
        btn3 = self.create_row_button(_("Launch ZapFast"), lambda *a: self.launch_local_app(["/usr/bin/zapfast"]))
        r3 = self.create_action_row(
            _("ZapFast"),
            _("Fast native desktop WhatsApp client built with Rust."),
            "chat-message-new-symbolic",
            btn3
        )
        listbox.append(r3)

        box.append(listbox)
        self.carousel.append(slide)

