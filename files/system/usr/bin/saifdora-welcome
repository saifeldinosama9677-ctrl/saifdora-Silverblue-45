        """Slide 1: Out-of-the-box readiness."""
        slide, box = self.create_slide_container(
            "package-x-generic-symbolic",
            _("Ready Out of the Box"),
            _("Saifdora Silverblue 45 includes comprehensive codecs, hardware acceleration, and essential utilities pre-configured.")
        )
        listbox = Gtk.ListBox()
        listbox.add_css_class("boxed-list")

        r1 = Adw.ActionRow(
            title=_("Multimedia & Hardware Acceleration"),
            subtitle=_("Full codec support (HEVC, AV1, HEIC) and hardware video decoding for Intel and AMD.")
        )
        r1.add_prefix(Gtk.Image.new_from_icon_name("video-x-generic-symbolic"))
        listbox.append(r1)

        r2 = Adw.ActionRow(
            title=_("Curated Repositories"),
            subtitle=_("Flathub and RPM Fusion (Free & Non-Free) enabled out of the box.")
        )
        r2.add_prefix(Gtk.Image.new_from_icon_name("software-properties-symbolic"))
        listbox.append(r2)

        r3 = Adw.ActionRow(
            title=_("Global Localization"),
            subtitle=_("Full support for 12 languages with completed GNOME 51 translations and international fonts.")
        )
        r3.add_prefix(Gtk.Image.new_from_icon_name("preferences-desktop-locale-symbolic"))
        listbox.append(r3)

        r4 = Adw.ActionRow(
            title=_("Archiving & Documents"),
            subtitle=_("Integrated support for 7-Zip, RAR, ZIP, PDF tools, and high-performance image processing.")
        )
        r4.add_prefix(Gtk.Image.new_from_icon_name("package-x-generic-symbolic"))
        listbox.append(r4)

        box.append(listbox)
        self.carousel.append(slide)

    def build_slide_apps(self):
        """Slide 2: Integrated productivity apps."""
        slide, box = self.create_slide_container(
            "applications-accessories-symbolic",
            _("Integrated Productivity Apps"),
            _("High-performance desktop applications installed natively in your system.")
        )
        listbox = Gtk.ListBox()
        listbox.add_css_class("boxed-list")

        # Rumman
        r1 = Adw.ActionRow(
            title=_("Rumman (File & Media Converter)"),
            subtitle=_("High-performance media converter and file optimizer.")
        )
        r1.add_prefix(Gtk.Image.new_from_icon_name("system-run-symbolic"))
        btn1 = Gtk.Button(label=_("Launch Rumman"))
        btn1.add_css_class("pill")
        btn1.set_valign(Gtk.Align.CENTER)
        btn1.connect("clicked", lambda *a: self.launch_app(["/usr/bin/rumman"]))
        r1.add_suffix(btn1)
        listbox.append(r1)

        # Mister Download Manager
        r2 = Adw.ActionRow(
            title=_("Mister Download Manager"),
            subtitle=_("Fast download manager automatically integrated with Firefox.")
        )
        r2.add_prefix(Gtk.Image.new_from_icon_name("folder-download-symbolic"))
        btn2 = Gtk.Button(label=_("Launch MDM"))
        btn2.add_css_class("pill")
        btn2.set_valign(Gtk.Align.CENTER)
        btn2.connect("clicked", lambda *a: self.launch_app(["/usr/bin/misterdownloadmanager"]))
        r2.add_suffix(btn2)
        listbox.append(r2)

        # ZapFast
        r3 = Adw.ActionRow(
            title=_("ZapFast"),
            subtitle=_("Fast native desktop WhatsApp client built with Rust.")
        )
        r3.add_prefix(Gtk.Image.new_from_icon_name("chat-message-new-symbolic"))
        btn3 = Gtk.Button(label=_("Launch ZapFast"))
        btn3.add_css_class("pill")
        btn3.set_valign(Gtk.Align.CENTER)
        btn3.connect("clicked", lambda *a: self.launch_app(["/usr/bin/zapfast"]))
        r3.add_suffix(btn3)
        listbox.append(r3)

        box.append(listbox)
        self.carousel.append(slide)

