        """Slide 3: Interface customization & extensions (3 rows)."""
        slide, box = self.create_slide_container(
            "preferences-desktop-appearance-symbolic",
            _("Interface Customization & Extensions"),
            _("Enhance and personalize your GNOME desktop with pre-configured extensions and utilities.")
        )
        listbox = Gtk.ListBox()
        listbox.add_css_class("boxed-list")
        listbox.set_selection_mode(Gtk.SelectionMode.NONE)

        # Row 1: Lockscreen Clock (informational)
        r1 = self.create_action_row(
            _("Lockscreen Clock"),
            _("Lockscreen clock with weather and smart regional dates (adapting month names and local calendars by country), fully customizable."),
            "preferences-system-time-symbolic"
        )
        listbox.append(r1)

        # Row 2: Desktop Extensions (Smart Flatpak Launcher)
        btn2 = self.create_row_button(_("Manage Extensions"), lambda *a: self.launch_flatpak_app("com.mattjakeman.ExtensionManager"))
        r2 = self.create_action_row(
            _("Desktop Extensions"),
            _("Includes ArcMenu app launcher, Dash to Dock, and Clipboard Indicator."),
