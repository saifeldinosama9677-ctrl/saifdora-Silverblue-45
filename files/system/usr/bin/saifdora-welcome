        )
        listbox.append(r2)

        # Row 3: Interface Tweaks (Smart Flatpak Launcher)
        btn3 = self.create_row_button(_("Customize Desktop"), lambda *a: self.launch_flatpak_app("page.tesk.Refine"))
        r3 = self.create_action_row(
            _("Interface Tweaks"),
            _("Fine-tune window buttons and GNOME appearance using Refine."),
            "preferences-system-symbolic",
            btn3
        )
        listbox.append(r3)

        box.append(listbox)
        self.carousel.append(slide)

