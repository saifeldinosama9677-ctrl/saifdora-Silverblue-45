    def build_slide_navigation(self):
        """Slide 5: GNOME 51 navigation basics."""
        slide, box = self.create_slide_container(
            "input-keyboard-symbolic",
            _("GNOME 51 Navigation Basics"),
            _("Master simple gestures and shortcuts to move swiftly through your workspace.")
        )
        listbox = Gtk.ListBox()
        listbox.add_css_class("boxed-list")

        r1 = Adw.ActionRow(
            title=_("Super Key & Search"),
            subtitle=_("Press the Super (Windows) key to open the Activities Overview, search apps, files, or do quick math.")
        )
        r1.add_prefix(Gtk.Image.new_from_icon_name("system-search-symbolic"))
        listbox.append(r1)

        r2 = Adw.ActionRow(
            title=_("Touchpad Gestures"),
            subtitle=_("Swipe up/down with 3 fingers for Overview; swipe left/right with 3 fingers to switch workspaces.")
        )
        r2.add_prefix(Gtk.Image.new_from_icon_name("input-touchpad-symbolic"))
        listbox.append(r2)

        r3 = Adw.ActionRow(
            title=_("Dynamic Workspaces"),
            subtitle=_("Workspaces are created automatically as you open windows to keep your desktop organized.")
        )
        r3.add_prefix(Gtk.Image.new_from_icon_name("view-paged-symbolic"))
        listbox.append(r3)

        box.append(listbox)

        # Finish button
        finish_btn = Gtk.Button(label=_("Get Started"))
        finish_btn.add_css_class("pill")
        finish_btn.add_css_class("suggested-action")
        finish_btn.set_halign(Gtk.Align.CENTER)
        finish_btn.set_margin_top(12)
        finish_btn.connect("clicked", lambda *a: self.close())
        box.append(finish_btn)

        self.carousel.append(slide)

    def launch_app(self, cmd_args):
        """Helper to safely launch applications asynchronously."""
        try:
            subprocess.Popen(cmd_args)
        except Exception as e:
            print(f"Error launching {cmd_args}: {e}", file=sys.stderr)

    def on_install_nvidia(self, *args):
        self.launch_app(["/usr/bin/saifdora-nvidia-manager"])

    def on_prev_clicked(self, *args):
        curr = int(round(self.carousel.get_position()))
        if curr > 0:
            self.carousel.scroll_to(self.carousel.get_nth_page(curr - 1), True)

    def on_next_clicked(self, *args):
        curr = int(round(self.carousel.get_position()))
        total = self.carousel.get_n_pages()
        if curr < total - 1:
            self.carousel.scroll_to(self.carousel.get_nth_page(curr + 1), True)
        else:
            self.close()

    def on_page_changed(self, carousel, index):
        total = carousel.get_n_pages()
        self.prev_btn.set_sensitive(index > 0)
        if index == total - 1:
            self.next_btn.set_icon_name("emblem-ok-symbolic")
            self.next_btn.set_tooltip_text(_("Get Started"))
        else:
            self.next_btn.set_icon_name("go-next-symbolic")
            self.next_btn.set_tooltip_text(_("Next"))

    def on_switch_toggled(self, switch, state):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        if state:
            # Active means show on startup -> remove seen file
            if os.path.exists(SEEN_FILE):
                try:
                    os.remove(SEEN_FILE)
                except Exception:
                    pass
        else:
            # Inactive means do not show on startup -> create seen file
            try:
                with open(SEEN_FILE, "w") as f:
                    f.write("seen\n")
            except Exception:
                pass


class WelcomeApplication(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )

    def do_command_line(self, command_line):
        args = command_line.get_arguments()
        if "--autostart" in args:
            if os.path.exists(SEEN_FILE):
                return 0

        self.activate()
        return 0

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            win = WelcomeWindow(application=self)
        win.present()


def main():
    # Direct CLI check for quick exit on autostart before GTK init
    if "--autostart" in sys.argv:
        if os.path.exists(SEEN_FILE):
            sys.exit(0)

    app = WelcomeApplication()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
