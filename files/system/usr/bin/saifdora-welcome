        r1.add_prefix(Gtk.Image.new_from_icon_name("emblem-favorite-symbolic"))
        listbox.append(r1)

        r2 = Adw.ActionRow(
            title=_("Extension Manager"),
            subtitle=_("Search, install, and update GNOME Shell extensions seamlessly.")
