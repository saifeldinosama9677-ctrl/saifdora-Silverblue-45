    def launch_local_app(self, cmd_args):
        """Safely launch local applications asynchronously."""
        try:
            subprocess.Popen(cmd_args)
        except Exception as e:
            print(f"Error launching {cmd_args}: {e}", file=sys.stderr)

    def launch_flatpak_app(self, app_id):
        """Smart Flatpak launcher with background installation toast fallback."""
        try:
            res = subprocess.run(["flatpak", "info", app_id], capture_output=True, text=True, check=False)
            if res.returncode == 0:
                subprocess.Popen(["flatpak", "run", app_id])
                return
        except Exception:
            pass

        # App is not yet installed or downloading in background
        msg = _("Application installation is completing in the background, it will appear in the menu within minutes")
        toast = Adw.Toast.new(msg)
        toast.set_timeout(4)
        self.toast_overlay.add_toast(toast)

        # Trigger background installation
        try:
            subprocess.Popen(["flatpak", "install", "-y", "--system", "flathub", app_id])
        except Exception as e:
            print(f"Error triggering flatpak install for {app_id}: {e}", file=sys.stderr)

    def on_install_nvidia(self, *args):
        self.launch_local_app(["/usr/bin/saifdora-nvidia-manager"])

    def on_prev_clicked(self, *args):
        curr = int(round(self.carousel.get_position()))
        if curr > 0:
            self.carousel.scroll_to(self.carousel.get_nth_page(curr - 1), True)

    def on_next_clicked(self, *args):
        curr = int(round(self.carousel.get_position()))
        total = self.carousel.get_n_pages()
        if curr < total - 1:
            self.carousel.scroll_to(self.carousel.get_nth_page(curr + 1), True)
        else:
            self.close()

    def on_page_changed(self, carousel, index):
        total = carousel.get_n_pages()
        self.prev_btn.set_visible(index > 0)
        if index == total - 1:
            self.next_btn.set_label(_("Get Started"))
        else:
            self.next_btn.set_label(_("Next"))

    def on_startup_toggled(self, button):
        state = button.get_active()
        os.makedirs(CONFIG_DIR, exist_ok=True)
        if state:
            # Active means show on startup -> remove seen file
            if os.path.exists(SEEN_FILE):
                try:
                    os.remove(SEEN_FILE)
                except Exception:
                    pass
        else:
            # Inactive means do not show on startup -> create seen file
            try:
                with open(SEEN_FILE, "w") as f:
                    f.write("seen\n")
            except Exception:
                pass


class WelcomeApplication(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )

    def do_command_line(self, command_line):
        args = command_line.get_arguments()
        if "--autostart" in args:
            if os.path.exists(SEEN_FILE):
                return 0

        self.activate()
        return 0

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            win = WelcomeWindow(application=self)
        win.present()


def main():
    # Fast exit for autostart if already seen before starting GTK
    if "--autostart" in sys.argv:
        if os.path.exists(SEEN_FILE):
            sys.exit(0)

    app = WelcomeApplication()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
