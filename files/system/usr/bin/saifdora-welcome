            _("Hardware & System Updates"),
            _("Optimized for smooth performance across Intel, AMD, and NVIDIA hardware.")
        )
        listbox = Gtk.ListBox()
        listbox.add_css_class("boxed-list")
        listbox.set_selection_mode(Gtk.SelectionMode.NONE)

        r1 = self.create_action_row(
            _("Intel & AMD Acceleration"),
            _("Hardware video acceleration (VA-API / Mesa / Intel Media Driver) is pre-configured and active."),
            "video-joined-displays-symbolic"
        )
        listbox.append(r1)

        btn2 = self.create_row_button(_("Open NVIDIA Manager"), lambda *a: self.launch_local_app(["/usr/bin/saifdora-nvidia-manager"]))
        r2 = self.create_action_row(
            _("NVIDIA & CUDA Drivers"),
