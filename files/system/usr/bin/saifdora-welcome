        listbox.add_css_class("boxed-list")

        r1 = Adw.ActionRow(
            title=_("Intel & AMD Acceleration"),
            subtitle=_("Hardware video acceleration (VA-API / Mesa / Intel Media Driver) is pre-configured and active.")
        )
        r1.add_prefix(Gtk.Image.new_from_icon_name("video-joined-displays-symbolic"))
        listbox.append(r1)

        r2 = Adw.ActionRow(
            title=_("NVIDIA & CUDA Drivers"),
            subtitle=_("Detect your GPU model, install official drivers, configure CUDA, and manage Secure Boot.")
        )
        r2.add_prefix(Gtk.Image.new_from_icon_name("display-projector-symbolic"))
        btn2 = Gtk.Button(label=_("Open NVIDIA Manager"))
        btn2.add_css_class("pill")
        btn2.add_css_class("suggested-action")
        btn2.set_valign(Gtk.Align.CENTER)
        btn2.connect("clicked", lambda *a: self.launch_app(["/usr/bin/saifdora-nvidia-manager"]))
        r2.add_suffix(btn2)
        listbox.append(r2)

