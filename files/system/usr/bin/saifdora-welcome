#!/usr/bin/env python3
"""
Saifdora Welcome App (saifdora-welcome)
Interactive onboarding application for Saifdora Silverblue 45.
Built with Python 3, GTK 4, and Libadwaita following GNOME 51 Human Interface Guidelines.
"""

import sys
import os
import subprocess
import gettext
import locale
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio

# --- Configuration & Paths ---
APP_ID = "org.saifdora.welcome"
CONFIG_DIR = os.path.expanduser("~/.config/saifdora")
SEEN_FILE = os.path.join(CONFIG_DIR, "welcome-seen")

# Check relative project locale directory first, then fallback to system locale
script_dir = os.path.dirname(os.path.abspath(__file__))
relative_locale = os.path.abspath(os.path.join(script_dir, "../share/locale"))

if os.path.isdir(relative_locale):
    LOCALE_DIR = relative_locale
else:
    LOCALE_DIR = "/usr/share/locale"

# --- Internationalization (gettext) ---
try:
    locale.setlocale(locale.LC_ALL, "")
except Exception:
    pass

gettext.bindtextdomain("saifdora-welcome", LOCALE_DIR)
gettext.textdomain("saifdora-welcome")

# Determine active language (respecting LANGUAGE and LC_ALL / LANG)
current_lang = os.environ.get("LANGUAGE", "").split(":")[0] or os.environ.get("LC_ALL", "") or locale.getlocale()[0] or os.environ.get("LANG", "")

languages = [current_lang] if current_lang else None
t = gettext.translation("saifdora-welcome", LOCALE_DIR, languages=languages, fallback=True)
_ = t.gettext

# Check text direction for RTL languages (Arabic, Urdu)
if current_lang.startswith(("ar", "ur")):
    Gtk.Widget.set_default_direction(Gtk.TextDirection.RTL)
else:
    Gtk.Widget.set_default_direction(Gtk.TextDirection.LTR)


def check_nvidia_status():
    """Detect presence of NVIDIA GPU and whether proprietary driver is installed."""
    has_nvidia = False
    driver_installed = False
    try:
        res = subprocess.run(["lspci", "-nn"], capture_output=True, text=True, check=False)
        for line in res.stdout.splitlines():
            if "[10de:" in line:
                has_nvidia = True
                break
    except Exception:
        pass

    if has_nvidia:
        try:
            res_rpm = subprocess.run(["rpm", "-q", "akmod-nvidia", "akmod-nvidia-580xx"],
                                     capture_output=True, text=True, check=False)
            if "akmod-nvidia" in res_rpm.stdout and "not installed" not in res_rpm.stdout:
                driver_installed = True
        except Exception:
            pass

        try:
            if os.path.exists("/proc/modules"):
                with open("/proc/modules", "r") as f:
                    if "nvidia " in f.read():
                        driver_installed = True
        except Exception:
            pass

    return has_nvidia, driver_installed


class WelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title(_("Welcome to Saifdora"))
        self.set_default_size(760, 580)
        self.set_resizable(True)

        # Root ToastOverlay
        self.toast_overlay = Adw.ToastOverlay()
        self.set_content(self.toast_overlay)

        # Main ToolbarView
        self.toolbar_view = Adw.ToolbarView()
        self.toast_overlay.set_child(self.toolbar_view)

        # Flat HeaderBar with Centered Indicator Dots
        self.header_bar = Adw.HeaderBar()
        self.header_bar.add_css_class("flat")
        self.toolbar_view.add_top_bar(self.header_bar)

        # NVIDIA Notification Banner
        self.banner = Adw.Banner()
        self.banner.set_title(_("NVIDIA graphics card detected! Official drivers are not installed."))
        self.banner.set_button_label(_("Install NVIDIA & CUDA Driver"))
        self.banner.connect("button-clicked", self.on_install_nvidia)
        self.toolbar_view.add_top_bar(self.banner)

        # Check NVIDIA status
        has_nvidia, driver_installed = check_nvidia_status()
        if has_nvidia and not driver_installed:
            self.banner.set_revealed(True)

        # Carousel Container (Disable scroll wheel to avoid touchpad conflict)
        self.carousel = Adw.Carousel()
        self.carousel.set_allow_scroll_wheel(False)
        self.carousel.set_hexpand(True)
        self.carousel.set_vexpand(True)
        self.carousel.connect("page-changed", self.on_page_changed)
        self.toolbar_view.set_content(self.carousel)

        # Set Centered Indicator Dots in HeaderBar
        self.dots = Adw.CarouselIndicatorDots()
        self.dots.set_carousel(self.carousel)
        self.header_bar.set_title_widget(self.dots)

        # Bottom Action Bar
        self.action_bar = Gtk.ActionBar()

        # Start: Previous button (hidden on first page) & Startup checkbox
        self.prev_btn = Gtk.Button(label=_("Previous"))
        self.prev_btn.set_visible(False)
        self.prev_btn.connect("clicked", self.on_prev_clicked)
        self.action_bar.pack_start(self.prev_btn)

        self.startup_check = Gtk.CheckButton(label=_("Show on startup"))
        self.startup_check.set_active(not os.path.exists(SEEN_FILE))
        self.startup_check.connect("toggled", self.on_startup_toggled)
        self.action_bar.pack_start(self.startup_check)

        # End: Next / Get Started button
        self.next_btn = Gtk.Button(label=_("Next"))
        self.next_btn.add_css_class("suggested-action")
        self.next_btn.add_css_class("pill")
        self.next_btn.connect("clicked", self.on_next_clicked)
        self.action_bar.pack_end(self.next_btn)

        self.toolbar_view.add_bottom_bar(self.action_bar)

        # Build 5 Carousel Slides
        self.build_slide_ready()
        self.build_slide_apps()
        self.build_slide_extensions()
        self.build_slide_hardware()
        self.build_slide_navigation()

    def create_slide_container(self, icon_name, title, subtitle):
        """Helper to create standard clamped, non-horizontal scrolling slide layout."""
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_hexpand(True)
        scrolled.set_vexpand(True)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(560)
        clamp.set_margin_top(24)
        clamp.set_margin_bottom(24)
        clamp.set_margin_start(24)
        clamp.set_margin_end(24)
        clamp.set_valign(Gtk.Align.CENTER)
        scrolled.set_child(clamp)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        clamp.set_child(box)

        # Header Icon & Titles
        if icon_name:
            img = Gtk.Image.new_from_icon_name(icon_name)
            img.set_pixel_size(64)
            img.set_halign(Gtk.Align.CENTER)
            img.add_css_class("accent")
            box.append(img)

        title_lbl = Gtk.Label(label=title)
        title_lbl.add_css_class("title-1")
        title_lbl.set_wrap(True)
        title_lbl.set_justify(Gtk.Justification.CENTER)
        box.append(title_lbl)

        sub_lbl = Gtk.Label(label=subtitle)
        sub_lbl.add_css_class("body")
        sub_lbl.add_css_class("dim-label")
        sub_lbl.set_wrap(True)
        sub_lbl.set_justify(Gtk.Justification.CENTER)
        box.append(sub_lbl)

        return scrolled, box

