[Unit]
Description=Apply Saifdora Burgundy Accent Theme

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p "$HOME/.config/gtk-4.0" "$HOME/.config/gtk-3.0" && cp -f /etc/skel/.config/gtk-4.0/gtk.css "$HOME/.config/gtk-4.0/gtk.css" && cp -f /etc/skel/.config/gtk-3.0/gtk.css "$HOME/.config/gtk-3.0/gtk.css"'

[Install]
WantedBy=default.target
