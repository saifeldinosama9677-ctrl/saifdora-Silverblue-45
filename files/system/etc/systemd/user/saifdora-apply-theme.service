[Unit]
Description=Apply Saifdora Burgundy Accent Theme
Before=graphical-session.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p "$HOME/.config/gtk-4.0" "$HOME/.config/gtk-3.0" && cp -f /etc/skel/.config/gtk-4.0/gtk.css "$HOME/.config/gtk-4.0/gtk.css" && cp -f /etc/skel/.config/gtk-3.0/gtk.css "$HOME/.config/gtk-3.0/gtk.css" && gsettings set org.gnome.desktop.interface accent-color "red" 2>/dev/null || true'

[Install]
WantedBy=default.target
